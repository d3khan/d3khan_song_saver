{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "d3khan song saver",
  "mainBinaryName": "d3khan song saver",
  "version": "0.2.12",
  "identifier": "com.d3khan.songsaver",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "d3khan song saver",
        "width": 1100,
        "height": 900,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm"
    ],
    "externalBin": [
      "binaries/downloader",
      "binaries/spotify_meta",
      "binaries/d3khan-ffmpeg"
    ],
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}