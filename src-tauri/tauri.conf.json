{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "d3khan song saver",
  "mainBinaryName": "d3khan song saver",
  "version": "0.2.0",
  "identifier": "com.d3khan.songsaver",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "d3khan song saver",
        "width": 1100,
        "height": 900,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "externalBin": [
      "binaries/downloader"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}